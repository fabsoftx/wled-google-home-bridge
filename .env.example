# Port the relay listens on
PORT=3080

# WLED base URL on your LAN. The http:// scheme is optional (assumed if omitted).
# This registers a single device named "default".
# Example: WLED_HOST=http://192.168.1.100
WLED_HOST=http://192.168.1.XXX

# Optional: multiple devices as comma-separated name=host pairs.
# Names: lowercase a-z, 0-9, hyphen. The device named "default" (or the first
# listed) answers the un-prefixed /api/v1/wled/* routes; others are reached at
# /api/v1/wled/<name>/*. If set, WLED_HOST is still added as "default" unless a
# device is explicitly named "default".
# Example: WLED_DEVICES=desk=192.168.1.100,lamp=192.168.1.101
WLED_DEVICES=

# Shared secret required on incoming /api/v1/* requests, sent as the
# "x-relay-token" header or an "Authorization: Bearer <token>" header.
# Leave empty to disable authentication (only safe on a trusted LAN / dev).
API_AUTH_TOKEN=

# When true, requests from loopback (127.0.0.1 / ::1) skip the token check.
# Requests arriving through a Cloudflare Tunnel are still authenticated —
# they are detected via the cf-ray / cf-connecting-ip headers even though
# the socket address is loopback. Has no effect when API_AUTH_TOKEN is empty.
ALLOW_LOCAL_UNAUTHENTICATED=false

# Set to true ONLY when running behind Cloudflare Tunnel / Cloudflare proxy so
# rate limiting uses the real caller IP from "cf-connecting-ip". Leave false if
# exposing PORT directly without Cloudflare (otherwise that header can be spoofed).
TRUST_CLOUDFLARE=true

# Hard timeout for every WLED HTTP call, in milliseconds.
TIMEOUT_MS=3000

# Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Set to "development" for pino-pretty human-readable logs.
NODE_ENV=production

# --- Google Home (Smart Home Cloud-to-Cloud) ---
# Leave all empty to disable. If any are set, all four of CLIENT_ID,
# CLIENT_SECRET, ADMIN_PASSWORD and TOKEN_SIGNING_SECRET are required.
# Generate values with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# You invent CLIENT_ID / CLIENT_SECRET here and paste the same values into the
# Google Home Developer Console (Account linking section).
GOOGLE_CLIENT_ID=
# Min 24 chars.
GOOGLE_CLIENT_SECRET=
# Optional but recommended: your Google project ID. Pins the OAuth redirect to
# https://oauth-redirect.googleusercontent.com/r/<GOOGLE_PROJECT_ID>
GOOGLE_PROJECT_ID=
# Password you type on the /oauth/authorize page when linking. Min 12 chars.
ADMIN_PASSWORD=
# HMAC key for access/refresh tokens. Min 32 chars. Changing it unlinks
# Google Home immediately (all tokens become invalid).
TOKEN_SIGNING_SECRET=
